<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <application android:name=".AftrhrsApplication" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/app_icon" android:roundIcon="@drawable/app_icon"
        android:label="AFTRHRS" android:supportsRtl="true" android:theme="@style/Theme.AFTRHRS"
        android:usesCleartextTraffic="false">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="aftrhrs" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".launcher.DefaultIcon" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:icon="@drawable/app_icon_default" android:roundIcon="@drawable/app_icon_default" android:label="AFTRHRS">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.EclipseIcon" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/app_icon_eclipse" android:roundIcon="@drawable/app_icon_eclipse" android:label="AFTRHRS">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.MidnightIcon" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/app_icon_midnight" android:roundIcon="@drawable/app_icon_midnight" android:label="AFTRHRS">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.AuroraIcon" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/app_icon_aurora" android:roundIcon="@drawable/app_icon_aurora" android:label="AFTRHRS">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.PrismIcon" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/app_icon_prism" android:roundIcon="@drawable/app_icon_prism" android:label="AFTRHRS">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.OrbitIcon" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/app_icon_orbit" android:roundIcon="@drawable/app_icon_orbit" android:label="AFTRHRS">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity-alias>
    </application>
</manifest>
